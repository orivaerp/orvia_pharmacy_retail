{
  "name": "orvia-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Orvia pharmacy retail SaaS - REST API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "seed": "cross-env NODE_ENV=development node src/scripts/seed.js",
    "seed:prod": "cross-env NODE_ENV=production node src/scripts/seed.js",
