# Template only - copy to .env.development / .env.production and fill in real values.
# Never put real credentials in this file; it is committed to git.
NODE_ENV=development
PORT=5000

# MongoDB Atlas -> Connect -> Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orvia?retryWrites=true&w=majority

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CORS_ORIGIN=http://localhost:4200

# Used only by "npm run seed"
SEED_ADMIN_EMAIL=admin@orvia.local
SEED_ADMIN_PASSWORD=
SEED_OWNER_EMAIL=owner@demo-pharmacy.local
SEED_OWNER_PASSWORD=

# Razorpay keys for UPI QR (test keys in development, live keys in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=
RAZORPAY_WEBHOOK_SECRET=
PUBLIC_API_URL=http://localhost:5000

# Email (SMTP). Leave empty to switch email off; invite links are then shown on screen.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Or, instead of SMTP_USER / SMTP_PASS / MAIL_FROM: EMAIL_USER (login and sender address), EMAIL_PASS, EMAIL_FROM_NAME (display name)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=Orvia <no-reply@yourdomain.com>

# Subscription billing (invoices carry these details)
COMPANY_NAME=Orvia
COMPANY_ADDRESS=
COMPANY_GSTIN=
BANK_DETAILS=
BILLING_GST_PERCENT=18
BILLING_GRACE_DAYS=7
