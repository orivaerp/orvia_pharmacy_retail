# Template only - copy to .env.development / .env.production and fill in real values.
# Never put real credentials in this file; it is committed to git.
NODE_ENV=development
PORT=5000

# MongoDB Atlas -> Connect -> Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orvia?retryWrites=true&w=majority

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# the web app's address, exactly (https://, no trailing slash). Several: separate with commas.
CORS_ORIGIN=http://localhost:4200
# the same address: the start of every invitation, password-reset and customer bill link
FRONTEND_URL=http://localhost:4200
# how many reverse proxies (nginx, a load balancer) sit in front of this API: 1 behind one nginx, 0 when reached directly
TRUST_PROXY=0

# Used only by "npm run seed"
SEED_ADMIN_EMAIL=admin@orvia.local
SEED_ADMIN_PASSWORD=
SEED_OWNER_EMAIL=owner@demo-pharmacy.local
SEED_OWNER_PASSWORD=

# Razorpay keys for UPI QR (test keys in development, live keys in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=
RAZORPAY_WEBHOOK_SECRET=
# the public address of this API (production: https://apis.stuintern.in), shown to shops as their Razorpay webhook address
PUBLIC_API_URL=http://localhost:5000

# Email over SMTP, built for Amazon SES. Leave SMTP_HOST empty to switch email off; invite links are then shown on screen.
# SES SMTP endpoint of your region: https://docs.aws.amazon.com/general/latest/gr/ses.html (587 = STARTTLS, 465 = SSL)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
# the SMTP credentials made in the SES console (they are NOT your AWS access key and the user name is not an email address)
SMTP_USER=
SMTP_PASS=
# a verified SES identity (an address, or any address on a verified domain)
MAIL_FROM=Orvia <no-reply@yourdomain.com>
# where replies go when a message does not name its own
MAIL_REPLY_TO=support@yourdomain.com

# Subscription billing (invoices carry these details)
COMPANY_NAME=Orvia
COMPANY_ADDRESS=
COMPANY_GSTIN=
BANK_DETAILS=
BILLING_GST_PERCENT=18
BILLING_GRACE_DAYS=7
